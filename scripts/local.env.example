# Copy to scripts/local.env (gitignored) and fill in your own values.
# Every script sources it; anything left unset falls back to a neutral default.

# ssh host alias of the Rockchip board you build and test on
#RCDL_BOARD=rk3588
# checkout location on the board, relative to $HOME there
#RCDL_BOARD_DEST=projects/rcdl

# ssh host alias of the x86 machine running rknn-toolkit2 (model conversion),
# and the models dir of the conversion project on it (used by fetch_models.sh
# to pull finished .rknn files)
#RCDL_CONVERT_HOST=your-convert-host
#RCDL_CONVERT_MODELS=/your/path/to/convert-project/models

# A local rknn_model_zoo checkout (for its prebuilt .rknn download scripts)
#RCDL_SRC_ZOO=/your/path/to/rknn_model_zoo
